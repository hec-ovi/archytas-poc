# portal SIGProv. El usuario y la clave son los que figuran en el enunciado.
PORTAL_BASE_URL=https://prueba-tecnica-portal.vercel.app
PORTAL_USER=
PORTAL_PASSWORD=

# agente: servidor OpenAI-compatible. Por defecto el llama.cpp local de esta maquina.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=gemma-4-26b-a4b-qat-q4
LLM_API_KEY=

# avisos: canales separados por coma (whatsapp, telegram, outbox).
# Sin credenciales, todo cae en la bandeja local (outbox).
NOTIFY_CHANNELS=outbox
NOTIFY_OUTBOX_PATH=/data/inbox/outbox.jsonl

# WhatsApp Cloud API. En el numero de prueba de Meta va WHATSAPP_MODE=development,
# que le saca el 9 a los celulares argentinos (si no, error 131030).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_MODE=development

# Telegram, como canal de respaldo sin tramite de aprobacion
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=

# desde que direcciones puede llamar la interfaz, separadas por coma.
# Vacio equivale a http://localhost:5173, que es donde corre por defecto.
CORS_ORIGINS=

# sesiones
SECRET_KEY=cordillera-cambiar-esta-clave-en-produccion

# donde viven la base y los archivos
CORDILLERA_DATA_DIR=/data

# binarios externos. Solo hace falta tocarlos si no estan en el PATH.
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm

# version de la Graph API de Meta
WHATSAPP_API_VERSION=v25.0
