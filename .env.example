# portal SIGProv
PORTAL_BASE_URL=https://prueba-tecnica-portal.vercel.app
PORTAL_USER=proveedor
PORTAL_PASSWORD=cordillera2026

# agente: servidor OpenAI-compatible. Por defecto el llama.cpp local de esta maquina.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=gemma-4-26b-a4b-qat-q4
LLM_API_KEY=

# avisos: canales separados por coma. Sin credenciales, todo cae en la bandeja local.
NOTIFY_CHANNELS=bandeja
NOTIFY_OUTBOX_PATH=/data/avisos.jsonl

# WhatsApp Cloud API. En el numero de prueba de Meta va WHATSAPP_MODE=development,
# que le saca el 9 a los celulares argentinos (si no, error 131030).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_MODE=development

# Telegram, como canal de respaldo sin tramite de aprobacion
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=

# sesiones
SECRET_KEY=cordillera-cambiar-esta-clave-en-produccion

# donde viven la base y los archivos
CORDILLERA_DATA_DIR=/data
